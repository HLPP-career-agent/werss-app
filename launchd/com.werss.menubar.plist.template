<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.werss.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/WERSS菜单栏.app/Contents/MacOS/main</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- SuccessfulExit=false: 仅异常退出(崩溃/被信号杀)才拉起;菜单「退出」等正常退出(exit 0)保持退出。
         重新拉起用 launchctl kickstart gui/$(id -u)/com.werss.menubar(不带 -k,任务仍在 launchd 只是没在跑)。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
